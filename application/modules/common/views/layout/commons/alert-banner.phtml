<?php
// Free announcement configured in pwd.json (EPISCIENCES.RENDER_ALERT_BANNER), e.g. an upcoming service interruption.
// The messages come from the server configuration and may contain HTML (e.g. a link to more information).
$banner = $this->alertBannerConfig
    ?? (defined('EPISCIENCES_RENDER_ALERT_BANNER') ? EPISCIENCES_RENDER_ALERT_BANNER : []);

$message = '';
if (is_array($banner) && !empty($banner['STATUS'])) {
    $lang = Zend_Registry::isRegistered('lang') ? Zend_Registry::get('lang') : null;
    $key = $lang === Episciences_Review::DEFAULT_LANG ? 'DEFAULT_LANG' : 'FR';
    $message = (string) ($banner['MESSAGE'][$key] ?? '');
}
?>
<?php if ($message !== ''): ?>
    <div class="alert alert-warning text-center" role="status">
        <?= $this->translate($message) ?>
    </div>
<?php endif; ?>
