<?php
$isFailure = $this->resultMessage == Ccsd_User_Models_User::ACCOUNT_RESET_PASSWORD_FAILURE;
$isSuccess = $this->resultMessage == Ccsd_User_Models_User::ACCOUNT_RESET_PASSWORD_SUCCESS;
?>
<?php if ($this->activatesAccount) : ?>
<h2><?= $this->escape($this->translate('Activation de votre compte')) ?></h2>
<?php if (!$this->resultMessage) : ?>
<p><?= $this->escape($this->translate("Choisissez le mot de passe de votre compte pour l'activer.")) ?></p>
<?php endif; ?>
<?php else : ?>
<h2><?= $this->escape($this->translate('Changement de votre mot de passe')) ?></h2>
<?php endif; ?>

<?php if ($isFailure) : ?>
<div class="alert alert-danger" role="alert">
    <p><strong><i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
        <?= $this->escape($this->translate("Ce lien n'est plus valide")) ?></strong></p>
    <p><?= $this->escape($this->translate('Il a peut-être expiré ou déjà été utilisé. Demandez un nouveau lien : il vous sera envoyé par e-mail.')) ?></p>
</div>
<p>
    <a class="btn btn-primary" href="<?= $this->escape($this->url(['controller' => 'user', 'action' => 'lostpassword'], null, true)) ?>">
        <i class="fas fa-envelope" aria-hidden="true"></i>
        <?= $this->escape($this->translate('Demander un nouveau lien')) ?>
    </a>
</p>
<?php endif; ?>

<?php if ($isSuccess) : ?>
<div class="alert alert-success" role="status">
    <p><i class="fas fa-check-circle" aria-hidden="true"></i>
        <?= $this->escape($this->activatesAccount
            ? $this->translate('Votre compte est activé : vous pouvez vous connecter avec ce mot de passe.')
            : $this->translate('Votre mot de passe a bien été changé')) ?></p>
</div>
<p>
    <a class="btn btn-primary" href="<?= $this->escape($this->url(['controller' => 'user', 'action' => 'login'], null, true)) ?>">
        <i class="fas fa-sign-in-alt" aria-hidden="true"></i>
        <?= $this->escape($this->translate('Connexion')) ?>
    </a>
</p>
<?php endif; ?>

<?php
if ($this->form) {
    $this->form->setAction($this->url());
    echo $this->form;
}
