<form data-library="ccsd" hidden aria-labelledby="accept-form-title"<?php
foreach (['name' => $this->element->getAttrib('name'), 'id' => $this->element->getAttrib('id'), 'class' => $this->element->getAttrib('class'), 'action' => $this->element->getAction(), 'method' => $this->element->getMethod()] as $attribute => $value) {
    if ($value) {
        echo ' ' . $attribute . '="' . $this->escape($value) . '"';
    }
}
?>>
    <div class="panel panel-default">
        <div class="panel-heading">
            <h2 class="panel-title" id="accept-form-title" tabindex="-1"><?php echo $this->translate($this->name) ?></h2>
        </div>
        <div class="panel-body in">
            <?php
            foreach ($this->element->getElements() as $element) {
                echo $element;
            }
            ?>
        </div>
    </div>
</form>
