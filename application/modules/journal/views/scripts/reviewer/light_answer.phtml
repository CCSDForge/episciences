<?php
/**
 * Answer without an account to a review request (#319): opinion (message and/or file) or refusal, from the invitation
 * link. Expected view vars: paper, lightAnswer (null before the first answer), lightAnswerForm, refuse_form (null once
 * answered), isEditable, rating_deadline, requestTypeLabel, csrfToken.
 */
/** @var \Episciences\Reviewer\LightAnswer|null $answer */
$answer = $this->lightAnswer;
/** @var Zend_Form $form */
$form = $this->lightAnswerForm;
$messageElement = $form->getElement(\Episciences\Reviewer\LightAnswerForm::MESSAGE);
$fileElement = $form->getElement(\Episciences\Reviewer\LightAnswerForm::FILE);
$messageErrors = $messageElement ? $messageElement->getMessages() : [];
$fileErrors = $fileElement ? $fileElement->getMessages() : [];
$this->layout()->pageTitle = $this->translate('Votre réponse à la demande de relecture');
?>

<p class="info-box">
    <?= $this->escape($this->translate('Type de demande')) ?> : <strong><?= $this->escape($this->requestTypeLabel) ?></strong>
    <?php if ($this->rating_deadline) : ?>
        <br><?= $this->escape($this->translate('Date limite')) ?> : <?= $this->Date($this->rating_deadline) ?>
    <?php endif; ?>
</p>

<div>
    <?= $this->paper->getXslt() ?>
    <?= $this->partial('paper/paper_files.phtml', ['paper' => $this->paper]) ?>
</div>

<?php if ($answer !== null && !$this->isEditable) : ?>
    <div class="panel panel-default">
        <div class="panel-heading">
            <h2 class="panel-title"><?= $this->escape($this->translate('Votre réponse')) ?></h2>
        </div>
        <div class="panel-body">
            <p class="text-muted"><?= $this->escape($this->translate("La date limite est passée : votre réponse ne peut plus être modifiée.")) ?></p>
            <p><?= nl2br($this->escape($answer->getMessage())) ?></p>
            <?php if ($answer->getFile() !== null) : ?>
                <p><?= $this->escape($this->translate('Fichier joint')) ?> : <?= $this->escape($answer->getFile()) ?></p>
            <?php endif; ?>
        </div>
    </div>
<?php else : ?>
    <div class="panel panel-default">
        <div class="panel-heading">
            <h2 class="panel-title"><?= $this->escape($this->translate('Votre réponse')) ?></h2>
        </div>
        <div class="panel-body">
            <?php if ($this->requestTypeInstructions !== '') : ?>
                <p class="lead"><?= nl2br($this->escape($this->requestTypeInstructions)) ?></p>
            <?php endif; ?>
            <p><?= $this->escape($this->translate('Vous pouvez saisir un texte, déposer un fichier, ou les deux. Aucun compte n\'est nécessaire.')) ?></p>
            <?php if ($answer !== null) : ?>
                <p class="text-muted">
                    <?= $this->escape($this->translate('Vous pouvez modifier votre réponse jusqu\'à la date limite.')) ?>
                </p>
            <?php endif; ?>

            <?php if ($this->lightAnswerMissing) : ?>
                <div class="alert alert-danger" role="alert" id="opinion-missing">
                    <?= $this->escape($this->translate('Merci de saisir une réponse ou de déposer un fichier.')) ?>
                </div>
            <?php endif; ?>

            <form method="post" enctype="multipart/form-data" id="light-answer-form" novalidate>
                <input type="hidden" name="csrf_token" value="<?= $this->escape($this->csrfToken) ?>">

                <div class="form-group<?= $messageErrors ? ' has-error' : '' ?>">
                    <label for="opinion" class="control-label"><?= $this->escape($this->translate('Votre réponse')) ?></label>
                    <textarea id="opinion" name="opinion" rows="10" class="form-control"
                              maxlength="<?= \Episciences\Reviewer\LightAnswer::MESSAGE_MAX_LENGTH ?>"
                        <?= $messageErrors ? 'aria-invalid="true" aria-describedby="opinion-error"' : ($this->lightAnswerMissing ? 'aria-describedby="opinion-missing"' : '') ?>><?= $this->escape((string)($messageElement ? $messageElement->getValue() : '')) ?></textarea>
                    <?php if ($messageErrors) : ?>
                        <span id="opinion-error" class="help-block"><?= $this->escape(implode(' ', array_map([$this, 'translate'], $messageErrors))) ?></span>
                    <?php endif; ?>
                </div>

                <div class="form-group<?= $fileErrors ? ' has-error' : '' ?>">
                    <label for="opinion_file" class="control-label"><?= $this->escape($this->translate('Fichier (facultatif)')) ?></label>
                    <?php if ($answer !== null && $answer->getFile() !== null) : ?>
                        <p class="form-control-static">
                            <?= $this->escape($this->translate('Fichier actuel')) ?> : <?= $this->escape($answer->getFile()) ?>
                            (<?= $this->escape($this->translate('un nouveau fichier le remplace')) ?>)
                        </p>
                    <?php endif; ?>
                    <input type="file" id="opinion_file" name="opinion_file"
                           aria-describedby="opinion_file-help<?= $fileErrors ? ' opinion_file-error' : '' ?>"<?= $fileErrors ? ' aria-invalid="true"' : '' ?>>
                    <span id="opinion_file-help" class="help-block"><?= Episciences_Tools::buildAttachedFilesDescription() ?></span>
                    <?php if ($fileErrors) : ?>
                        <span id="opinion_file-error" class="help-block"><?= $this->escape(implode(' ', array_map([$this, 'translate'], $fileErrors))) ?></span>
                    <?php endif; ?>
                </div>

                <button type="submit" name="submitopinion" value="1" class="btn btn-primary">
                    <?= $this->escape($this->translate($answer === null ? 'Envoyer ma réponse' : 'Enregistrer les modifications')) ?>
                </button>
            </form>
        </div>
    </div>

    <?php if ($this->refuse_form) : ?>
        <details class="panel panel-default"<?= $this->invalid_refuse_form ? ' open' : '' ?>>
            <summary class="panel-heading"><?= $this->escape($this->translate("Je ne souhaite pas répondre à cette demande")) ?></summary>
            <div class="panel-body">
                <?= $this->refuse_form ?>
            </div>
        </details>
    <?php endif; ?>
<?php endif; ?>
