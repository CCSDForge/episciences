<?php
/**
 * Answer without an account to a review request (#319): the rating grid of the request filled in from the invitation
 * link, or a refusal. Expected view vars: paper, lightAnswer (null before the first answer), lightAnswerReport (the
 * grid, null when none is configured), lightAnswerForm (null when no grid is configured), refuse_form (null once
 * answered), isEditable, rating_deadline, requestTypeLabel, requestTypeInstructions, lightAnswerErrors.
 */
/** @var \Episciences\Reviewer\LightAnswer|null $answer */
$answer = $this->lightAnswer;
/** @var Zend_Form|null $form */
$form = $this->lightAnswerForm;
$this->layout()->pageTitle = $this->translate('Votre réponse à la demande de relecture');
?>

<p class="info-box">
    <?= $this->escape($this->translate('Type de demande')) ?> : <strong><?= $this->escape($this->requestTypeLabel) ?></strong>
    <?php if ($this->rating_deadline) : ?>
        <br><?= $this->escape($this->translate('Date limite')) ?> : <?= $this->Date($this->rating_deadline) ?>
    <?php endif; ?>
</p>

<?php // answer associated with the signed-in account, or the form to associate it (#319) ?>
<?php if ($answer !== null && $this->answerOfAccount) : ?>
    <div class="alert alert-info" role="status">
        <?php if ($this->answerLinkedNow) : ?>
            <?= $this->escape($this->translate("Votre compte utilise l'adresse de l'invitation : votre réponse lui a été associée.")) ?>
        <?php endif; ?>
        <?= $this->escape($this->translate('Cette réponse est associée à votre compte : vous la retrouvez dans « Mes relectures ».')) ?>
    </div>
<?php elseif ($answer !== null && $this->canLinkAnswer) : ?>
    <form method="post" action="" class="well well-sm" id="link-light-answer">
        <input type="hidden" name="csrf_token" value="<?= $this->escape($this->csrfToken) ?>">
        <p id="link-light-answer-help">
            <?= $this->escape(sprintf(
                $this->translate("Vous êtes connecté avec le compte %s. Associez cette réponse à votre compte pour la retrouver dans « Mes relectures » ; elle reste une réponse sans compte, visible seulement du comité éditorial."),
                (string)Episciences_Auth::getScreenName()
            )) ?>
        </p>
        <button type="submit" name="link_light_answer" value="1" class="btn btn-default" aria-describedby="link-light-answer-help">
            <?= $this->escape($this->translate('Associer cette réponse à mon compte')) ?>
        </button>
    </form>
<?php endif; ?>

<div>
    <?= $this->paper->getXslt() ?>
    <?= $this->partial('paper/paper_files.phtml', ['paper' => $this->paper]) ?>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h2 class="panel-title"><?= $this->escape($this->translate('Votre réponse')) ?></h2>
    </div>
    <div class="panel-body">
        <?php if ($answer !== null && !$this->isEditable) : ?>
            <p class="text-muted"><?= $this->escape($this->translate("La date limite est passée : votre réponse ne peut plus être modifiée.")) ?></p>
            <?= $this->partial('partials/light_answer_report.phtml', ['report' => $this->lightAnswerReport, 'aid' => $answer->getAid(), 'withLinks' => false]) ?>
        <?php elseif ($form === null) : ?>
            <div class="alert alert-warning" role="status">
                <?= $this->escape($this->translate("Aucune grille de relecture n'est configurée pour cette demande : vous ne pouvez pas y répondre pour le moment. Le comité éditorial en a été informé ; votre lien d'invitation reste valable.")) ?>
            </div>
        <?php else : ?>
            <?php if ($this->requestTypeInstructions !== '') : ?>
                <p class="lead"><?= nl2br($this->escape($this->requestTypeInstructions)) ?></p>
            <?php endif; ?>
            <p><?= $this->escape($this->translate("Remplissez la grille ci-dessous. Aucun compte n'est nécessaire.")) ?></p>
            <?php if ($answer !== null) : ?>
                <p class="text-muted">
                    <?= $this->escape($this->translate("Vous pouvez modifier votre réponse jusqu'à la date limite. Un nouveau fichier remplace celui déjà envoyé pour le même critère.")) ?>
                </p>
                <?php $sentFiles = \Episciences\Reviewer\LightAnswerReport::attachments($this->lightAnswerReport); ?>
                <?php if ($sentFiles !== []) : ?>
                    <p>
                        <?= $this->escape($this->translate('Fichiers déjà envoyés')) ?> :
                        <?= $this->escape(implode(', ', $sentFiles)) ?>
                    </p>
                <?php endif; ?>
            <?php endif; ?>

            <?php if ($this->lightAnswerErrors) : ?>
                <div class="alert alert-danger" role="alert">
                    <?= $this->escape($this->translate("Votre réponse n'a pas pu être enregistrée : vérifiez les champs signalés et les fichiers joints.")) ?>
                </div>
            <?php endif; ?>

            <?= $form ?>
        <?php endif; ?>
    </div>
</div>

<?php if ($this->refuse_form && ($answer === null || $this->isEditable)) : ?>
    <details class="panel panel-default"<?= $this->invalid_refuse_form ? ' open' : '' ?>>
        <summary class="panel-heading"><?= $this->escape($this->translate("Je ne souhaite pas répondre à cette demande")) ?></summary>
        <div class="panel-body">
            <?= $this->refuse_form ?>
        </div>
    </details>
<?php endif; ?>
