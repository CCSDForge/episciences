<?php
/** @var Zend_Controller_Request_Http $request */
$request = Zend_Controller_Front::getInstance()->getRequest();
$controller = $request->getControllerName();
$action = $request->getActionName();
?>
<?php if ($this->yearCategories) : ?>
    <nav class="stats-years" aria-label="<?= $this->escape($this->translate('Année')) ?>">
        <a class="stats-year<?= !$this->yearQuery ? ' active' : '' ?>"
           <?= !$this->yearQuery ? 'aria-current="page"' : '' ?>
           href="<?= '/' . $controller . '/' . $action ?>"><?= $this->translate('Tout') ?></a>
        <?php foreach ($this->yearCategories as $year): ?>
            <a class="stats-year<?= ($this->yearQuery === $year) ? ' active' : '' ?>"
               <?= ($this->yearQuery === $year) ? 'aria-current="page"' : '' ?>
               href="<?= '/' . $controller . '/' . $action . '?year=' . (int)$year ?>"><?= (int)$year ?></a>
        <?php endforeach; ?>
    </nav>
<?php endif; ?>
