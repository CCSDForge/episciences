<?php
/**
 * Conference fields and proceedings DOI of the volume form, shown when "Actes de conférences" is checked
 * (public/js/volume/confproceeding.js).
 *
 * @var Zend_View $this
 * @var Ccsd_Form $form
 * @var array<string, mixed> $doi data of the DOI row, see Episciences_VolumesManager::getProceedingsDoiViewData()
 */
$form = $this->form;
$isProceeding = (string)$form->getElement(Episciences_Volume::VOLUME_IS_PROCEEDING)->getValue() === '1';

$requiredFields = [
    Episciences_Volume::VOLUME_CONFERENCE_NAME,
    Episciences_Volume::VOLUME_CONFERENCE_START_DATE,
    Episciences_Volume::VOLUME_CONFERENCE_END_DATE,
];
$dateFields = [Episciences_Volume::VOLUME_CONFERENCE_START_DATE, Episciences_Volume::VOLUME_CONFERENCE_END_DATE];
$helpTexts = [
    Episciences_Volume::VOLUME_CONFERENCE_ACRONYM => $this->translate('Exemple : MFPS'),
    Episciences_Volume::VOLUME_CONFERENCE_NUMBER => $this->translate('Exemple : 51'),
    Episciences_Volume::VOLUME_CONFERENCE_START_DATE => $this->translate('Format : AAAA-MM-JJ'),
    Episciences_Volume::VOLUME_CONFERENCE_END_DATE => $this->translate('Format : AAAA-MM-JJ'),
];
?>
<fieldset id="conference-fields" class="proceedings-fields"<?= $isProceeding ? '' : ' hidden' ?>
          data-text-end-before-start="<?= $this->escape($this->translate(Episciences\Volume\ProceedingsValidator::MSG_END_BEFORE_START)) ?>">
    <legend><?= $this->escape($this->translate('Conférence et actes')) ?></legend>

    <?php foreach (Episciences_VolumesManager::PROCEEDINGS_FIELDS as $name) : ?>
        <?php
        $element = $form->getElement($name);
        $messages = $element->getMessages();
        $describedBy = [];
        if (isset($helpTexts[$name])) {
            $describedBy[] = $name . '-help';
        }
        if ($messages !== []) {
            $describedBy[] = $name . '-error';
        }
        $isRequired = in_array($name, $requiredFields, true);
        ?>
        <div id="<?= $this->escape($name) ?>-element" class="form-group<?= $messages !== [] ? ' has-error' : '' ?>">
            <label for="<?= $this->escape($name) ?>" class="col-md-3 control-label <?= $isRequired ? 'required' : 'optional' ?>">
                <?= $this->escape($this->translate($element->getLabel())) ?>
            </label>
            <div class="col-md-9">
                <input type="<?= in_array($name, $dateFields, true) ? 'date' : 'text' ?>"
                       id="<?= $this->escape($name) ?>"
                       name="<?= $this->escape($name) ?>"
                       value="<?= $this->escape((string)$element->getValue()) ?>"
                       class="form-control input-sm"
                       <?= $isRequired ? 'data-proceedings-required' : '' ?>
                       <?= $isRequired && $isProceeding ? 'required aria-required="true"' : '' ?>
                       <?= $isProceeding ? '' : 'disabled' ?>
                       <?= $describedBy !== [] ? 'aria-describedby="' . $this->escape(implode(' ', $describedBy)) . '"' : '' ?>
                       <?= $messages !== [] ? 'aria-invalid="true"' : '' ?>>
                <?php if (isset($helpTexts[$name])) : ?>
                    <p id="<?= $this->escape($name) ?>-help" class="help-block"><?= $this->escape($helpTexts[$name]) ?></p>
                <?php endif; ?>
                <?php if ($messages !== []) : ?>
                    <p id="<?= $this->escape($name) ?>-error" class="help-block"><?= $this->escape(implode(' ', $messages)) ?></p>
                <?php endif; ?>
            </div>
        </div>
    <?php endforeach; ?>

    <?= $this->partial('volume/doi_proceedings_row.phtml', ['doi' => $this->doi, 'disabled' => !$isProceeding]) ?>
</fieldset>
