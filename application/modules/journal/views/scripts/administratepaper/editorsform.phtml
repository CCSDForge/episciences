<style>
    .editors-list {
        max-height: 150px;
        overflow: auto;
        margin-bottom: 10px;
    }
</style>
<?php
$suggestedEditorNames = [];
if (is_iterable($this->suggestedEditors) && is_array($this->editors)) {
    foreach ($this->suggestedEditors as $editorId) {
        if (array_key_exists($editorId, $this->editors)) {
            $suggestedEditorNames[] = $this->escape($this->editors[$editorId]->getFullname());
        }
    }
}
?>
<?php if (!empty($suggestedEditorNames)) : ?>
<div class="alert alert-info">
    <p><i>
            <?= $this->translate(array("L'auteur a suggéré un rédacteur", "L'auteur a suggéré des rédacteurs", count($suggestedEditorNames))) ?>
            :
            <?= implode(', ', $suggestedEditorNames) ?>.</i>
    </p>
</div>
<?php endif; ?>

<?php if ($this->editorsForm) : ?>
    <?php echo $this->editorsForm; ?>
    <script type="text/javascript">
        var unavailableEditors = <?= isset($this->unavailableEditors) ? json_encode($this->unavailableEditors) : '[]' ?>;
        console.log('Unavailable editors from PHP:', unavailableEditors);

        // Initialize editor availability immediately
        if (typeof initializeEditorAvailability === 'function') {
            setTimeout(function() {
                initializeEditorAvailability();
            }, 100);
        }
    </script>
<?php else : ?>
    <?php echo $this->translate('Aucun rédacteur enregistré') . '.' ?>
<?php endif; ?>