/**
 * aria-describedby of a field: its help text and its error, when there are some
 */
$describedBy = static function (string $field, bool $hasHelp = false) use ($errors): string {
    $ids = [];
    if ($hasHelp) {
        $ids[] = $field . '-help';
    }
    if (isset($errors[$field])) {
        $ids[] = $field . '-error';
    }
    return $ids === [] ? '' : ' aria-describedby="' . implode(' ', $ids) . '"';
};

$error = function (string $field) use ($errors): string {
    return isset($errors[$field])
        ? '<span id="' . $field . '-error" class="help-block">' . $this->escape($this->translate($errors[$field])) . '</span>'
        : '';
};
?>

