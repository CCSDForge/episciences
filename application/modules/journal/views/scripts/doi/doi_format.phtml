<?php
/**
 * DOI format of the DOI settings form (doi/settings): the field, the available tags and a preview.
 * @var Zend_View $this
 */
$element = $this->element;
$name = $element->getName();
$labelClasses = trim('col-md-3 control-label' . ($element->hasErrors() ? ' error' : '') . ($element->isRequired() ? ' required' : ''));

// saved value (or default value)
$doiFormat = $element->getValue() ?: Episciences_Review_DoiSettings::SETTING_DOI_DEFAULT_DOI_FORMAT;

// tag => [description, example value used by the preview]
$tags = [
    Episciences_Review_DoiSettings::DOI_FORMAT_REVIEW_CODE => ['Code de la revue', mb_strtolower(RVCODE)],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_VOLUME => ["Volume de l'article", 'Volume 12'],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_VOLUME_INT => ["Volume de l'article (seulement les nombres)", '12'],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_VOLUME_INT_REPLACEMENT_CHAR => ["Volume de l'article (seulement les nombres, séparés par le caractère entre crochets)", ''],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_VOLUME_BIB_REF => ["Volume de l'article (Référence bibliographique du volume)", 'vol12'],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_VOLUME_ORDER => ["Numéro de l'article dans un volume (ordre)", '3'],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_SECTION => ["Rubrique de l'article", 'Section 2'],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_SECTION_INT => ["Rubrique de l'article (seulement les nombres)", '2'],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_SECTION_INT_REPLACEMENT_CHAR => ["Rubrique de l'article (seulement les nombres, séparés par le caractère entre crochets)", ''],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_ID => ["Numéro de l'article (Identifiant pérenne)", '12345'],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_YEAR => ['Année de publication', date('Y')],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_YEAR_SHORT => ['Année de publication (2 chiffres)', date('y')],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_MONTH => ['Mois de publication', date('m')],
    Episciences_Review_DoiSettings::DOI_FORMAT_PAPER_AUTOINCREMENT => ['Auto-incrément basé sur le DOI précédent', '7'],
];
$examples = [];
foreach ($tags as $tag => [, $example]) {
    if ($example !== '') {
        $examples[$tag] = $example;
    }
}
?>
<label class="<?= $labelClasses ?>" for="<?= $this->escape($name) ?>">
    <?= $this->escape($this->translate((string)$element->getLabel())) ?>
</label>

<div class="col-md-9">
    <input name="<?= $this->escape($name) ?>"
           id="<?= $this->escape($name) ?>"
           type="text"
           required
           class="form-control input-sm doi-format-input"
           aria-describedby="<?= $this->escape($name) ?>-preview"
           data-doi-examples="<?= $this->escape(json_encode($examples, JSON_UNESCAPED_UNICODE)) ?>"
           value="<?= $this->escape((string)$doiFormat) ?>"/>

    <?php if ($element->hasErrors()) : ?>
        <div class="help-block error"><?= $this->formErrors($element->getMessages()) ?></div>
    <?php endif; ?>

    <p class="help-block doi-format-preview" id="<?= $this->escape($name) ?>-preview" aria-live="polite">
        <?= $this->translate('Exemple de DOI obtenu') ?> :
        <code class="doi-format-preview-value"></code>
    </p>
    <p class="help-block">
        <?= $this->translate("Le DOI est mis en minuscules ; les espaces sont supprimés.") ?>
    </p>

    <table class="table table-condensed doi-format-tags">
        <caption><?= $this->translate('Balises utilisables') ?></caption>
        <thead>
        <tr>
            <th scope="col"><?= $this->translate('Balise') ?></th>
            <th scope="col"><?= $this->translate('Valeur') ?></th>
            <th scope="col"><?= $this->translate('Exemple') ?></th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($tags as $tag => [$description, $example]) : ?>
            <tr>
                <th scope="row"><code><?= $this->escape($tag) ?></code></th>
                <td><?= $this->escape($this->translate($description)) ?></td>
                <td><?= $example !== '' ? '<code>' . $this->escape($example) . '</code>' : '' ?></td>
            </tr>
        <?php endforeach; ?>
        <tr>
            <th scope="row"><code>%%</code></th>
            <td><?= $this->translate('le caractère <kbd>%</kbd>') ?></td>
            <td><code>%</code></td>
        </tr>
        </tbody>
    </table>
</div>
