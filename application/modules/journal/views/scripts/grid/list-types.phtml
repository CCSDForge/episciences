<?php
/**
 * Review request types tab (#319) of the review settings page, with the grid used by the reports of each type
 */
$unitLabels = ['day' => 'jour(s)', 'week' => 'semaine(s)', 'month' => 'mois'];
$confirmDelete = json_encode($this->translate('Supprimer ce type de demande ?'), JSON_THROW_ON_ERROR | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);
?>

<p class="help-block">
    <?= $this->escape($this->translate("Le type est choisi à l'invitation d'un relecteur : il détermine le message envoyé et la date limite proposée. Un même relecteur peut recevoir une demande de chaque type pour un article.")) ?>
</p>

<p>
    <a class="btn btn-primary" href="/requesttype/edit">
        <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>
        <?= $this->escape($this->translate('Ajouter un type de demande')) ?>
    </a>
</p>

<table class="table table-striped">
    <caption class="sr-only"><?= $this->escape($this->translate('Types de demande de relecture')) ?></caption>
    <thead>
    <tr>
        <th scope="col"><?= $this->escape($this->translate('Position')) ?></th>
        <th scope="col"><?= $this->escape($this->translate('Libellé')) ?></th>
        <th scope="col"><?= $this->escape($this->translate('Code')) ?></th>
        <th scope="col"><?= $this->escape($this->translate('Délai par défaut')) ?></th>
        <th scope="col"><?= $this->escape($this->translate('État')) ?></th>
        <th scope="col"><?= $this->escape($this->translate('Grille de notation')) ?></th>
        <th scope="col"><span class="sr-only"><?= $this->escape($this->translate('Actions')) ?></span></th>
    </tr>
    </thead>
    <tbody>
    <?php foreach ($this->requestTypes as $id => $type) : ?>
        <?php
        /** @var \Episciences\Reviewer\RequestType $type */
        $label = $type->getLabel($this->locale);
        $hasGrid = isset($this->requestTypeGridIds[$id]);
        $deadline = \Episciences\Form\Validate\DeadlineUnit::parseStoredInterval($type->getDefaultDeadline());
        ?>
        <tr>
            <td><?= (int)$type->getPosition() ?></td>
            <td><?= $this->escape($label) ?></td>
            <td><code><?= $this->escape($type->getCode()) ?></code></td>
            <td>
                <?= $deadline !== null
                    ? (int)$deadline[0] . ' ' . $this->escape($this->translate($unitLabels[$deadline[1]] ?? $deadline[1]))
                    : $this->escape($this->translate('Réglage de la revue')) ?>
            </td>
            <td>
                <?php if ($type->isEnabled()) : ?>
                    <span class="label label-success"><?= $this->escape($this->translate('Actif')) ?></span>
                <?php else : ?>
                    <span class="label label-default"><?= $this->escape($this->translate('Désactivé')) ?></span>
                <?php endif; ?>
            </td>
            <td>
                <?php if ($type->isLightAnswer()) : ?>
                    <?= $this->escape($this->translate('Aucune : réponse sans compte')) ?>
                <?php elseif ($hasGrid) : ?>
                    <a href="/grid/list?tab=<?= GridController::TAB_GRIDS ?>#rating-grid-<?= $this->escape(Episciences_GridsManager::requestTypeGridKey($id)) ?>">
                        <?= $this->escape($this->translate('Grille du type')) ?>
                        <span class="sr-only"><?= $this->escape($label) ?></span>
                    </a>
                <?php else : ?>
                    <?= $this->escape($this->translate('Grille du volume, sinon grille par défaut')) ?>
                <?php endif; ?>
            </td>
            <td class="text-right">
                <a class="btn btn-default btn-xs" href="/requesttype/edit?id=<?= (int)$id ?>">
                    <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                    <?= $this->escape($this->translate('Modifier')) ?>
                    <span class="sr-only"><?= $this->escape($label) ?></span>
                </a>
                <?php if (!$type->isLightAnswer() && !$hasGrid) : ?>
                    <form method="post" action="/grid/add" style="display: inline">
                        <input type="hidden" name="csrf_token" value="<?= $this->escape($this->csrfToken) ?>">
                        <input type="hidden" name="request_type" value="<?= (int)$id ?>">
                        <button type="submit" name="submit" value="1" class="btn btn-default btn-xs">
                            <span class="glyphicon glyphicon-th-list" aria-hidden="true"></span>
                            <?= $this->escape($this->translate('Créer une grille')) ?>
                            <span class="sr-only"><?= $this->escape($label) ?></span>
                        </button>
                    </form>
                <?php endif; ?>
                <?php // the default types and the used types can only be disabled ?>
                <?php if (!$type->isDefault() && empty($this->usedRequestTypes[$id])) : ?>
                    <form method="post" action="/requesttype/delete" style="display: inline"
                          onsubmit="return confirm(<?= $this->escape($confirmDelete) ?>);">
                        <input type="hidden" name="csrf_token" value="<?= $this->escape($this->csrfToken) ?>">
                        <input type="hidden" name="id" value="<?= (int)$id ?>">
                        <button type="submit" class="btn btn-danger btn-xs">
                            <span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
                            <?= $this->escape($this->translate('Supprimer')) ?>
                            <span class="sr-only"><?= $this->escape($label) ?></span>
                        </button>
                    </form>
                <?php endif; ?>
            </td>
        </tr>
    <?php endforeach; ?>
    </tbody>
</table>

<p class="help-block">
    <?= $this->escape($this->translate("Les types par défaut et les types déjà utilisés ne peuvent pas être supprimés : désactivez-les pour ne plus les proposer (leur modèle de message n'est alors plus listé). Le message d'invitation de chaque type se modifie dans les modèles de mail.")) ?>
</p>
