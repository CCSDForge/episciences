<?php
/**
 * Review settings page: the default grid, one block per review request type (#319) with the grid it uses and the
 * actions on the type, then the grids of the volumes
 */
$this->jQuery()->addJavascriptFile(VENDOR_JQUERY_DATATABLES);
$this->jQuery()->addJavascriptFile(VENDOR_DATATABLES_BOOTSTRAP);
$this->jQuery()->addJavascriptFile('/js/library/es.dataTables.delete-buttons.js');
$this->jQuery()->addJavascriptFile('/js/grid/list.js');
$this->jQuery()->addJavascriptFile('/js/grid/list-toggles.js');
$this->jQuery()->addStylesheet(VENDOR_DATATABLES_CSS);

$requestTypes = $this->requestTypes ?: [];
// grids of the request types, by type id; a grid whose type no longer exists is listed apart
$typeGrids = [];
$orphanTypeGrids = [];
$volumeGrids = [];
foreach ($this->grids ?: [] as $key => $grid) {
    if ($key === 'grid_0') {
        continue;
    }
    $gridRequestTypeId = Episciences_GridsManager::requestTypeIdOfKey((string)$grid->getId());
    if ($gridRequestTypeId === null) {
        $volumeGrids[$key] = $grid;
    } elseif (isset($requestTypes[$gridRequestTypeId])) {
        $typeGrids[$gridRequestTypeId] = $grid;
    } else {
        $orphanTypeGrids[$key] = $grid;
    }
}
$defaultGrid = $this->grids['grid_0'] ?? null;
$isSecretary = Episciences_Auth::isSecretary();
$canManageTypes = (bool)$this->canManageTypes;
$unitLabels = ['day' => 'jour(s)', 'week' => 'semaine(s)', 'month' => 'mois'];
$confirmDelete = json_encode($this->translate('Supprimer ce type de demande ?'), JSON_THROW_ON_ERROR | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);
?>

<p class="help-block">
    <?= $this->escape($this->translate("Grille utilisée pour un rapport : celle du type de demande, sinon celle du volume de l'article (sauf pour un avis rapide), sinon la grille par défaut.")) ?>
</p>

<h2 class="h3" id="default-grid-heading"><?= $this->escape($this->translate('Grille par défaut')) ?></h2>

<div class="panel panel-default collapsable" id="rating-grid-0">
    <div class="panel-body in">
        <?php if ($defaultGrid !== null) : ?>
            <?= $this->partial('partials/grid_criteria.phtml', ['grid' => $defaultGrid, 'defaultGrid' => $defaultGrid, 'translator' => $this->translator]) ?>
        <?php else : ?>
            <p><?= $this->escape($this->translate('Aucun critère de notation')) ?>.</p>
            <?php if ($isSecretary) : ?>
                <a href="/grid/addcriterion" class="btn btn-default" role="button">
                    <?= $this->escape($this->translate('Ajouter un critère')) ?>
                </a>
            <?php endif; ?>
        <?php endif; ?>
    </div>
</div>

<h2 class="h3" id="request-types-heading"><?= $this->escape($this->translate('Types de demande')) ?></h2>
<p class="help-block">
    <?= $this->escape($this->translate("Le type est choisi à l'invitation d'un relecteur : il détermine le message envoyé et la date limite proposée. Un même relecteur peut recevoir une demande de chaque type pour un article.")) ?>
</p>

<?php if ($canManageTypes) : ?>
    <p>
        <a class="btn btn-primary" href="/requesttype/edit">
            <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>
            <?= $this->escape($this->translate('Ajouter un type de demande')) ?>
        </a>
    </p>
<?php endif; ?>

<?php foreach ($requestTypes as $id => $type) : ?>
    <?php
    /** @var \Episciences\Reviewer\RequestType $type */
    $label = $type->getLabel($this->locale);
    $grid = $typeGrids[$id] ?? null;
    $deadline = \Episciences\Form\Validate\DeadlineUnit::parseStoredInterval($type->getDefaultDeadline());
    $mayCreateGrid = $isSecretary && $grid === null && !$type->isLightAnswer();
    // the default types and the used types can only be disabled
    $mayDelete = $canManageTypes && !$type->isDefault() && empty($this->usedRequestTypes[$id]);
    ?>
    <div class="panel panel-default collapsable" id="rating-grid-<?= $this->escape(Episciences_GridsManager::requestTypeGridKey((int)$id)) ?>">
        <div class="panel-heading">
            <h3 class="panel-title">
                <?= $this->escape($label) ?>
                <small>
                    &middot; <?= $this->escape($this->translate('Délai par défaut')) ?> :
                    <?= $deadline !== null
                        ? (int)$deadline[0] . ' ' . $this->escape($this->translate($unitLabels[$deadline[1]] ?? $deadline[1]))
                        : $this->escape($this->translate('Réglage de la revue')) ?>
                </small>
                <?php if ($type->isEnabled()) : ?>
                    <span class="label label-success"><?= $this->escape($this->translate('Actif')) ?></span>
                <?php else : ?>
                    <span class="label label-default"><?= $this->escape($this->translate('Désactivé')) ?></span>
                <?php endif; ?>
                <?php if ($type->countsAsReport()) : ?>
                    <span class="label label-info"><?= $this->escape($this->translate('Compte comme rapport de relecture')) ?></span>
                <?php endif; ?>
            </h3>
        </div>
        <div class="panel-body in">
            <?php if ($type->isLightAnswer()) : ?>
                <?php if ($grid !== null) : ?>
                    <div class="alert alert-warning" role="status">
                        <?= $this->escape($this->translate("Ce type se répond sans compte : cette grille n'est pas utilisée tant que l'option reste cochée.")) ?>
                    </div>
                <?php else : ?>
                    <p><?= $this->escape($this->translate("Aucune grille : réponse sans compte, depuis le lien de l'invitation.")) ?></p>
                <?php endif; ?>
            <?php elseif ($grid === null && $type->isQuickOpinion()) : ?>
                <p><?= $this->escape($this->translate('Pas de grille propre : grille par défaut.')) ?></p>
            <?php elseif ($grid === null) : ?>
                <p><?= $this->escape($this->translate("Pas de grille propre : grille du volume de l'article, sinon grille par défaut.")) ?></p>
            <?php endif; ?>
            <?php if ($grid !== null) : ?>
                <?= $this->partial('partials/grid_criteria.phtml', ['grid' => $grid, 'defaultGrid' => $defaultGrid, 'translator' => $this->translator]) ?>
            <?php endif; ?>
        </div>
        <?php if ($canManageTypes) : ?>
            <div class="panel-footer text-center">
                <?php if ($mayCreateGrid) : ?>
                    <form method="post" action="/grid/add" style="display: inline">
                        <input type="hidden" name="csrf_token" value="<?= $this->escape($this->csrfToken) ?>">
                        <input type="hidden" name="request_type" value="<?= (int)$id ?>">
                        <button type="submit" name="submit" value="1" class="btn btn-default">
                            <span class="glyphicon glyphicon-th-list" aria-hidden="true"></span>
                            <?= $this->escape($this->translate('Créer une grille')) ?>
                            <span class="sr-only"><?= $this->escape($label) ?></span>
                        </button>
                    </form>
                <?php endif; ?>
                <a href="/requesttype/edit?id=<?= (int)$id ?>" class="btn btn-default" role="button">
                    <span class="glyphicon glyphicon-edit" aria-hidden="true"></span>
                    <?= $this->escape($this->translate('Modifier ce type de demande')) ?>
                    <span class="sr-only"><?= $this->escape($label) ?></span>
                </a>
                <?php if ($mayDelete) : ?>
                    <form method="post" action="/requesttype/delete" style="display: inline"
                          onsubmit="return confirm(<?= $this->escape($confirmDelete) ?>);">
                        <input type="hidden" name="csrf_token" value="<?= $this->escape($this->csrfToken) ?>">
                        <input type="hidden" name="id" value="<?= (int)$id ?>">
                        <button type="submit" class="btn btn-danger">
                            <span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
                            <?= $this->escape($this->translate('Supprimer ce type de demande')) ?>
                            <span class="sr-only"><?= $this->escape($label) ?></span>
                        </button>
                    </form>
                <?php endif; ?>
            </div>
        <?php endif; ?>
    </div>
<?php endforeach; ?>

<?php foreach ($orphanTypeGrids as $grid) : ?>
    <div class="panel panel-default collapsable" id="rating-grid-<?= $this->escape((string)$grid->getId()) ?>">
        <div class="panel-heading">
            <h3 class="panel-title"><?= $this->escape($this->translate('type supprimé')) ?></h3>
        </div>
        <div class="panel-body in">
            <?= $this->partial('partials/grid_criteria.phtml', ['grid' => $grid, 'defaultGrid' => $defaultGrid, 'translator' => $this->translator]) ?>
        </div>
    </div>
<?php endforeach; ?>

<?php if ($canManageTypes) : ?>
    <p class="help-block">
        <?= $this->escape($this->translate("Les types par défaut et les types déjà utilisés ne peuvent pas être supprimés : désactivez-les pour ne plus les proposer (leur modèle de message n'est alors plus listé). Le message d'invitation de chaque type se modifie dans les modèles de mail.")) ?>
    </p>
<?php endif; ?>

<h2 class="h3"><?= $this->escape($this->translate('Grilles par volume')) ?></h2>
<p class="help-block">
    <?= $this->escape($this->translate("Les rapports des articles d'un volume utilisent sa grille, sauf les avis rapides et les types de demande qui ont la leur.")) ?>
</p>

<?php $collapseVolumeGrids = count($volumeGrids) > GridController::VOLUME_GRIDS_SHOWN; ?>
<?php if ($volumeGrids === []) : ?>
    <p><?= $this->escape($this->translate('Aucune grille de volume.')) ?></p>
<?php elseif ($collapseVolumeGrids) : ?>
    <p class="help-block"><?= $this->escape($this->translate('Les grilles des volumes sont repliées : choisissez un volume pour afficher sa grille.')) ?></p>
<?php endif; ?>

<?php foreach ($volumeGrids as $grid) : ?>
    <?php
    $volumeGridId = (int)$grid->getId();
    $volumeTitle = Episciences_VolumesManager::translateVolumeKey('volume_' . $volumeGridId . '_title');
    $volumeLink = '<a href="/volume/edit?id=' . $volumeGridId . '" class="btn btn-default" role="button">'
        . '<span class="glyphicon glyphicon-edit" aria-hidden="true"></span> '
        . $this->escape($this->translate('Modifier ce volume')) . '</a>';
    ?>
    <div class="panel panel-default collapsable" id="rating-grid-<?= $volumeGridId ?>">
        <div class="panel-heading">
            <h3 class="panel-title">
                <?php if ($collapseVolumeGrids) : ?>
                    <?php // the heading of a collapsable panel toggles it (functions.js): the button makes it reachable with the keyboard ?>
                    <button type="button" class="btn btn-link" style="padding: 0" data-grid-toggle
                            aria-expanded="false" aria-controls="rating-grid-body-<?= $volumeGridId ?>">
                        <?= $this->escape($volumeTitle) ?>
                    </button>
                <?php else : ?>
                    <?= $this->escape($volumeTitle) ?>
                <?php endif; ?>
            </h3>
        </div>
        <div class="panel-body<?= $collapseVolumeGrids ? '' : ' in' ?>" id="rating-grid-body-<?= $volumeGridId ?>">
            <?= $this->partial('partials/grid_criteria.phtml', ['grid' => $grid, 'defaultGrid' => $defaultGrid, 'translator' => $this->translator]) ?>
            <?php // a collapsed panel only hides its body: the link to the volume goes in it ?>
            <?php if ($collapseVolumeGrids) : ?>
                <p class="text-center"><?= $volumeLink ?></p>
            <?php endif; ?>
        </div>
        <?php if (!$collapseVolumeGrids) : ?>
            <div class="panel-footer text-center"><?= $volumeLink ?></div>
        <?php endif; ?>
    </div>
<?php endforeach; ?>

<?php if ($isSecretary && $this->form) : ?>
    <?= $this->form ?>
<?php endif; ?>
