<?php
$this->jQuery()->addJavascriptFile(VENDOR_JQUERY_DATATABLES);
$this->jQuery()->addJavascriptFile(VENDOR_DATATABLES_BOOTSTRAP);
$this->jQuery()->addJavascriptFile('/js/library/es.dataTables.delete-buttons.js');
$this->jQuery()->addJavascriptFile('/js/grid/list.js');
$this->jQuery()->addJavascriptFile('/js/grid/list-tabs.js');
$this->jQuery()->addStylesheet(VENDOR_DATATABLES_CSS);

// Without the types tab (users who do not manage the request types), the grids are shown without tabs
$tabs = [GridController::TAB_GRIDS => $this->translate('Grilles de notation')];
if ($this->canManageTypes) {
    $tabs[GridController::TAB_TYPES] = $this->translate('Types de demande');
}
?>

<?php if (count($tabs) === 1) : ?>
    <?= $this->render('grid/list-grids.phtml') ?>
<?php else : ?>
    <ul class="nav nav-tabs" role="tablist" aria-label="<?= $this->escape($this->translate('Relecture : grilles et types de demande')) ?>" data-grid-list-tabs>
        <?php foreach ($tabs as $tab => $label) : ?>
            <?php $isActive = $tab === $this->activeTab; ?>
            <li role="presentation"<?= $isActive ? ' class="active"' : '' ?>>
                <a href="/grid/list?tab=<?= $this->escape($tab) ?>" id="tab-<?= $this->escape($tab) ?>" role="tab"
                   aria-controls="tabpanel-<?= $this->escape($tab) ?>" aria-selected="<?= $isActive ? 'true' : 'false' ?>"
                   tabindex="<?= $isActive ? '0' : '-1' ?>" data-tab="<?= $this->escape($tab) ?>">
                    <?= $this->escape($label) ?>
                </a>
            </li>
        <?php endforeach; ?>
    </ul>

    <div class="tab-content" style="padding-top: 15px">
        <?php foreach ($tabs as $tab => $label) : ?>
            <?php $isActive = $tab === $this->activeTab; ?>
            <div role="tabpanel" id="tabpanel-<?= $this->escape($tab) ?>" aria-labelledby="tab-<?= $this->escape($tab) ?>"
                 class="tab-pane<?= $isActive ? ' active' : '' ?>" tabindex="0"<?= $isActive ? '' : ' hidden' ?>>
                <?= $this->render($tab === GridController::TAB_TYPES ? 'grid/list-types.phtml' : 'grid/list-grids.phtml') ?>
            </div>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
