<?php
/**
 * Paper History Logs Display
 */
$this->jQuery()->addStylesheet("/css/log-history.css"); ?>

<?php foreach ($this->logs as $log) : ?>

    <?php
    // Decode JSON details + extract status/fullName/tag once per log entry (shared with activity timeline)
    ['detail' => $detail, 'status' => $status, 'fullName' => $fullName, 'tag' => $tag] = Episciences_Paper_Logger::extractLogDisplayData($log);

    // Check if this log has detailed modal view
    $hasDetails = Episciences_Paper_Logger::hasDetailModal($log['ACTION']);
    ?>

    <?php if ($hasDetails) : ?>
        <?php $logHref = '/administratepaper/log?id=' . $log['LOGID']; ?>
        <a class="modal-opener" href="<?= $logHref ?>"
           data-width="50%"
           data-hidesubmit="true"
           title="<?= isset(Episciences_Paper_Logger::$_label[$log['ACTION']]) ? $this->translate(Episciences_Paper_Logger::$_label[$log['ACTION']]) : $this->translate($log['ACTION']) ?>"
           aria-label="<?= $this->translate('View details for') . ' ' . (isset(Episciences_Paper_Logger::$_label[$log['ACTION']]) ? $this->translate(Episciences_Paper_Logger::$_label[$log['ACTION']]) : $this->translate($log['ACTION'])) ?>">
    <?php endif; ?>

    <div class="log-entry <?= $log['ACTION'] ?> alert alert-<?= Episciences_Paper_Logger::$_css[$log['ACTION']] ?> alert-fixed"
         role="alert"
         data-date="<?= $this->Date($log['DATE'], null, 'MM/dd/y') ?>"
         data-time="<?= $this->Date($log['DATE'], null, Zend_Date::TIME_MEDIUM) ?>"
         aria-live="polite">

        <span class="label label-<?= Episciences_Paper_Logger::$_css[$log['ACTION']] ?> log-timestamp"
              aria-label="<?= $this->translate('Date') ?>">
            <?= $this->Date($log['DATE'], null, Zend_Date::DATE_MEDIUM . ' ' . Zend_Date::TIME_MEDIUM) ?>
        </span>

        <span>
            <strong><?= isset(Episciences_Paper_Logger::$_label[$log['ACTION']]) ? $this->translate(Episciences_Paper_Logger::$_label[$log['ACTION']]) : $this->translate($log['ACTION']) ?></strong>

            <?= $this->partial('partials/paper_history_log_body.phtml', [
                'log' => $log,
                'detail' => $detail,
                'status' => $status,
                'fullName' => $fullName,
                'tag' => $tag
            ]) ?>

            <span class="log-detail-icon glyphicon glyphicon-plus" aria-hidden="true"></span>
        </span>
    </div>

    <?php if ($hasDetails) : ?>
        </a>
    <?php endif; ?>

<?php endforeach; ?>
