<?php
/**
 * Compact "go to a paper" search box, rendered inside a dashboard panel header.
 *
 * Expected view variables:
 *  - from  string optional, dashboard section the search is scoped to (UserController::*_STR)
 *  - title string optional, accessible name of the field (no visible label in this layout)
 */
$suffix = isset($this->from) ? '_' . $this->from : '';
$title = $this->title ?? 'Accès à un article';
?>
<div class="dashboard-search-container" data-component="dashboard-paper-search"
     data-suffix="<?= $this->escape($suffix) ?>" data-from="<?= $this->escape($this->from ?? '') ?>">
    <div class="input-group input-group-sm">
        <?php // No visible label in this compact layout: several of these boxes can coexist on the
              // dashboard, so each one carries its panel's title as its accessible name. ?>
        <input data-role="paper-identifier" class="form-control"
               aria-label="<?= $this->escape($this->translate($title)) ?>"
               placeholder="<?= $this->escape($this->translate("Identifiant de l'article")) ?>">
        <span class="input-group-btn">
            <button data-role="submit-btn" type="submit" class="btn btn-default"
                    aria-label="<?= $this->escape($this->translate('Rechercher')) ?>">
                <span class="glyphicon glyphicon-arrow-right" aria-hidden="true"></span>
            </button>
        </span>
    </div>
</div>

<?php $this->jQuery()->addJavascriptFile("/js/user/dashboard-paper-search.js"); ?>
