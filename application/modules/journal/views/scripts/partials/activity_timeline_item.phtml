<?php
/**
 * Single activity-timeline entry: date | marker | card, laid out along a left-hand
 * vertical line (see sass/components/_timeline-activity.scss).
 * Reuses Episciences_Paper_Logger (label/color/category/detail-modal) and the shared
 * paper_history_log_body.phtml partial, so the timeline and the "Historique" panel
 * always describe a given log entry identically.
 */
$log = $this->log;
$action = $log['ACTION'];

['detail' => $detail, 'status' => $status, 'fullName' => $fullName, 'tag' => $tag] = Episciences_Paper_Logger::extractLogDisplayData($log);

$cssColor = Episciences_Paper_Logger::$_css[$action] ?? Episciences_Paper_Logger::INFO;
$label = isset(Episciences_Paper_Logger::$_label[$action]) ? $this->translate(Episciences_Paper_Logger::$_label[$action]) : $this->translate($action);
$category = $log['CATEGORY'] ?? Episciences_Paper_Logger::getCategory($action);
$hasDetails = Episciences_Paper_Logger::hasDetailModal($action);
$icon = Episciences_Paper_Logger::getCategoryIcon($category);

$entryId = 'activity-event-' . $log['LOGID'];
?>
<div class="activity-timeline-row" data-category="<?= $this->escape($category) ?>">

    <?= $this->partial('partials/activity_timeline_date.phtml', [
        'date' => $log['DATE'],
        'version' => $log['VERSION'] ?? '',
        'docId' => $log['DOCID'] ?? null,
    ]) ?>

    <div class="activity-timeline-marker label label-<?= $cssColor ?>" aria-hidden="true">
        <span class="glyphicon <?= $icon ?>"></span>
    </div>

    <div class="activity-timeline-card" aria-labelledby="<?= $entryId ?>">

        <div class="label label-<?= $cssColor ?> activity-category-label"><?= $this->translate(Episciences_Paper_Logger::getCategoryLabel($category)) ?></div>

        <p id="<?= $entryId ?>" class="activity-timeline-label">
            <?php if ($hasDetails) : ?>
                <a class="modal-opener"
                   href="/administratepaper/log?id=<?= $log['LOGID'] ?>"
                   data-width="50%"
                   data-hidesubmit="true"
                   aria-label="<?= $this->translate('View details for') ?> <?= $label ?>">
                    <strong><?= $label ?></strong>
                    <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>
                </a>
            <?php else : ?>
                <strong><?= $label ?></strong>
            <?php endif; ?>
        </p>

        <div class="activity-timeline-body">
            <?= $this->partial('partials/paper_history_log_body.phtml', [
                'log' => $log,
                'detail' => $detail,
                'status' => $status,
                'fullName' => $fullName,
                'tag' => $tag,
            ]) ?>
        </div>

    </div>

</div>
