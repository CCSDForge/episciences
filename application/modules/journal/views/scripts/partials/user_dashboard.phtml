<?php
/**
 * Paper counts per status, for a dashboard panel.
 *
 * Two renderings share the same single source of truth ($groups below):
 *  - grid: one bordered quadrant per group (journal management panel)
 *  - linear (default): every count in a flat list, groups flattened in order
 *
 * Expected view variables:
 *  - papers         Episciences_Paper[]  the panel's papers
 *  - controllerName string               link target controller
 *  - actionName     string               link target action
 *  - gridLayout     bool                 optional, render as quadrants
 *  - ce             mixed                optional, copy editing flag forwarded to links
 */

$papers = $this->papers;
$params = ['controller' => $this->controllerName, 'action' => $this->actionName];
// Copy editing
if (isset($this->ce)) {
    $params['ce'] = $this->ce;
}

$isGrid = (bool)($this->gridLayout ?? false);

// [status => [singular label, plural label]], grouped and ordered for display.
// 'suggestions' marks the group holding the pending decision suggestion counts.
$groups = [
    [
        'title' => 'Évaluation',
        'icon' => 'glyphicon glyphicon-tasks',
        'statuses' => [
            Episciences_Paper::STATUS_SUBMITTED => ['article sans relecteur', 'articles sans relecteur'],
            Episciences_Paper::STATUS_OK_FOR_REVIEWING => ['article en attente de relecture', 'articles en attente de relecture'],
            Episciences_Paper::STATUS_BEING_REVIEWED => ['article en cours de relecture', 'articles en cours de relecture'],
            Episciences_Paper::STATUS_REVIEWED => ['article évalué, en attente de décision éditoriale', 'articles évalués, en attente de décision éditoriale'],
        ],
    ],
    [
        'title' => 'Révisions & suggestions',
        'icon' => 'glyphicon glyphicon-edit',
        'suggestions' => true,
        'statuses' => [
            Episciences_Paper::STATUS_WAITING_FOR_MINOR_REVISION => ['article en attente de modifications mineures', 'articles en attente de modifications mineures'],
            Episciences_Paper::STATUS_WAITING_FOR_MAJOR_REVISION => ['article en attente de modifications majeures', 'articles en attente de modifications majeures'],
            // Answer to a revision request: the author declined to revise
            Episciences_Paper::STATUS_NO_REVISION => ["article en attente d'une décision : refus de modifications", "articles en attente d'une décision : refus de modifications"],
        ],
    ],
    [
        'title' => 'Copy-editing & publication',
        'icon' => 'glyphicon glyphicon-duplicate',
        'statuses' => [
            Episciences_Paper::STATUS_ACCEPTED => ['article accepté', 'articles acceptés'],
            Episciences_Paper::STATUS_ACCEPTED_WAITING_FOR_AUTHOR_FINAL_VERSION => ["article accepté, en attente de la version finale de l'auteur", "articles acceptés, en attente de la version finale de l'auteur"],
            Episciences_Paper::STATUS_ACCEPTED_WAITING_FOR_MAJOR_REVISION => ['article accepté, en attente de modifications majeures', 'articles acceptés, en attente de modifications majeures'],
            Episciences_Paper::STATUS_ACCEPTED_FINAL_VERSION_SUBMITTED_WAITING_FOR_COPY_EDITORS_FORMATTING => ['article accepté - version finale soumise, en attente de la mise en forme par la revue', 'articles acceptés - versions finales soumises, en attente de la mise en forme par la revue'],
            Episciences_Paper::STATUS_TMP_VERSION_ACCEPTED => [
                Episciences_Paper::$_statusLabel[Episciences_Paper::STATUS_TMP_VERSION_ACCEPTED],
                'versions temporaires acceptées, en attente de la version finale',
            ],
            Episciences_Paper::STATUS_TMP_VERSION_ACCEPTED_AFTER_AUTHOR_MODIFICATION => [
                Episciences_Paper::$_statusLabel[Episciences_Paper::STATUS_TMP_VERSION_ACCEPTED_AFTER_AUTHOR_MODIFICATION],
                "versions temporaires acceptées après modification de l'auteur",
            ],
            Episciences_Paper::STATUS_TMP_VERSION_ACCEPTED_WAITING_FOR_MINOR_REVISION => [
                Episciences_Paper::$_statusLabel[Episciences_Paper::STATUS_TMP_VERSION_ACCEPTED_WAITING_FOR_MINOR_REVISION],
                'versions temporaires acceptées, en attente des modifications mineures',
            ],
            Episciences_Paper::STATUS_TMP_VERSION_ACCEPTED_WAITING_FOR_MAJOR_REVISION => [
                Episciences_Paper::$_statusLabel[Episciences_Paper::STATUS_TMP_VERSION_ACCEPTED_WAITING_FOR_MAJOR_REVISION],
                'versions temporaires acceptées, en attente des modifications majeures',
            ],
            Episciences_Paper::STATUS_CE_WAITING_FOR_AUTHOR_SOURCES => ['article en attente des sources auteurs', 'articles en attente des sources auteurs'],
            Episciences_Paper::STATUS_CE_AUTHOR_SOURCES_DEPOSED => ['article en attente de la mise en forme par la revue', 'articles en attente de la mise en forme par la revue'],
            Episciences_Paper::STATUS_CE_REVIEW_FORMATTING_DEPOSED => ['article mis en forme par la revue, en attente de la version finale', 'articles mis en forme par la revue, en attente de la version finale'],
            Episciences_Paper::STATUS_ACCEPTED_WAITING_FOR_AUTHOR_VALIDATION => ["article accepté, en attente de la validation par l'auteur", 'articles acceptés, en attente de validation par l\'auteur'],
            Episciences_Paper::STATUS_CE_WAITING_AUTHOR_FINAL_VERSION => ['article en attente de la version finale', 'articles en attente de la version finale'],
            Episciences_Paper::STATUS_CE_AUTHOR_FINAL_VERSION_DEPOSED => ['article version finale en attente de validation', 'articles version finale en attente de validation'],
            Episciences_Paper::STATUS_CE_AUTHOR_FORMATTING_DEPOSED => ["article mis en forme par l'auteur, en attente de la version définitive", "articles mis en forme par l'auteur, en attente de la version définitive"],
            Episciences_Paper::STATUS_APPROVED_BY_AUTHOR_WAITING_FOR_FINAL_PUBLICATION => ["article approuvé par l'auteur, en attente de publication", "articles approuvés par l'auteur, en attente de publication"],
            Episciences_Paper::STATUS_CE_READY_TO_PUBLISH => ['article en attente de la publication', 'articles en attente de la publication'],
        ],
    ],
    [
        'title' => 'Archives / historique',
        'icon' => 'fa-solid fa-box-archive',
        'statuses' => [
            Episciences_Paper::STATUS_PUBLISHED => ['article publié', 'articles publiés'],
            Episciences_Paper::STATUS_ABANDONED => ['article abandonné', 'articles abandonnés'],
            Episciences_Paper::STATUS_REFUSED => ['article refusé', 'articles refusés'],
        ],
    ],
];

// Pending decision suggestions, shown in the "Révisions & suggestions" group only.
// Single grouped query for the three counts.
$suggestionCounts = $isGrid ? Episciences_PapersManager::countPendingSuggestionsByType(RVID) : [];

$suggestionLinks = [
    Episciences_CommentsManager::TYPE_SUGGESTION_ACCEPTATION => [
        'class' => 'text-success',
        'icon' => 'fa-solid fa-file-circle-check',
        'labels' => ["suggestion d'acceptation", "suggestions d'acceptation"],
    ],
    Episciences_CommentsManager::TYPE_SUGGESTION_REFUS => [
        'class' => 'text-danger',
        'icon' => 'fa-solid fa-file-circle-xmark',
        'labels' => ['suggestion de refus', 'suggestions de refus'],
    ],
    Episciences_CommentsManager::TYPE_SUGGESTION_NEW_VERSION => [
        'class' => 'text-warning',
        'icon' => 'fa-solid fa-file-pen',
        'labels' => ['suggestion de modification', 'suggestions de modification'],
    ],
];
?>

<?php // One count line: "<n> articles <label>", linking to the filtered paper list ?>
<?php $renderStatusCount = function (int $status, array $labels) use ($papers, $params) { ?>
    <?php $count = Episciences_PapersManager::countByStatus($papers, [$status]); ?>
    <?php if ($count) : ?>
        <?php $params['status'] = [$status]; ?>
        <a href="<?= $this->url($params) ?>"><strong><?= $count ?></strong>
            <?= $this->translate(($count === 1) ? $labels[0] : $labels[1]) ?>
        </a><br/>
    <?php endif; ?>
<?php }; ?>

<?php $renderSuggestionCounts = function () use ($suggestionCounts, $suggestionLinks) { ?>
    <?php foreach ($suggestionLinks as $type => $suggestion) : ?>
        <?php $count = $suggestionCounts[$type] ?? 0; ?>
        <?php if ($count) : ?>
            <a class="<?= $suggestion['class'] ?>"
               href="<?= $this->url(['controller' => 'administratepaper', 'action' => 'list', 'suggestion' => $type]) ?>">
                <span class="<?= $suggestion['icon'] ?>" aria-hidden="true"></span>
                <strong><?= $count ?></strong>
                <?= $this->translate($count === 1 ? $suggestion['labels'][0] : $suggestion['labels'][1]) ?>
            </a><br/>
        <?php endif; ?>
    <?php endforeach; ?>
<?php }; ?>

<?php if ($isGrid): ?>
    <?php foreach (array_chunk($groups, 2) as $row): ?>
        <div class="row">
            <?php foreach ($row as $group): ?>
                <div class="col-sm-6 dashboard-quadrant">
                    <?php // h3: the panel title is an h2, so this keeps the heading hierarchy contiguous ?>
                    <h3 class="dashboard-quadrant-title">
                        <span class="<?= $group['icon'] ?>" aria-hidden="true"></span> <?= $this->translate($group['title']) ?>
                    </h3>

                    <?php foreach ($group['statuses'] as $status => $labels) : ?>
                        <?php $renderStatusCount($status, $labels); ?>
                    <?php endforeach; ?>

                    <?php if (!empty($group['suggestions'])) : ?>
                        <?php $renderSuggestionCounts(); ?>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endforeach; ?>
<?php else: ?>
    <?php foreach ($groups as $group) : ?>
        <?php foreach ($group['statuses'] as $status => $labels) : ?>
            <?php $renderStatusCount($status, $labels); ?>
        <?php endforeach; ?>
    <?php endforeach; ?>
<?php endif; ?>

<?php // Grand total ?>
<?php $count = count($papers); ?>
<?php if ($count) : ?>
    <?php unset($params['status']); ?>
    <br/>
    <strong><?= $this->translate('Total') ?> : </strong>
    <a href="<?= $this->url($params) ?>"><strong><?= $count ?></strong>
        <?= $this->translate(($count === 1) ? 'article' : 'articles') ?></a><br/>
<?php else : ?>
    <?= $this->translate('Aucun article pour le moment.') ?>
<?php endif; ?>
