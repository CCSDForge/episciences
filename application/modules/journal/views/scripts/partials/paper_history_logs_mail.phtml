<?php
/**
 * Log Detail Partial: Mail
 * Handles: CODE_MAIL_SENT, CODE_REMINDER_SENT
 * Display: to recipients (name as a mailto: link) : subject
 */
?>
<?php if (!empty($this->recipients)) : ?>
    <span class="log-mail-recipients" aria-label="<?= $this->translate('Recipients') ?>"><?= $this->translate("à") ?>&nbsp;<?php foreach ($this->recipients as $index => $recipient) : ?><?php if ($index > 0) : ?>, <?php endif; ?><?php
            $parsedRecipient = Episciences_Tools::postMailValidation($recipient);
            $recipientName = trim((string)($parsedRecipient['name'] ?: $parsedRecipient['email']), '" ');
            ?><a href="mailto:<?= $this->escape($parsedRecipient['email']) ?>"><?= $this->escape($recipientName) ?></a><?php endforeach; ?></span>
<?php endif; ?>
<span class="log-mail-subject">
    <?= $this->escape(htmlspecialchars_decode($this->subject, ENT_QUOTES)) ?>
</span>
