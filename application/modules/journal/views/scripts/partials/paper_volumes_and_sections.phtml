<?php

$controller = Zend_Controller_Front::getInstance()->getRequest()->getControllerName();
$action = Zend_Controller_Front::getInstance()->getRequest()->getActionName();

// CSS/JS via helper → queued on the deduplicated jQuery container and rendered once in <head>.
// A raw inline <script> here (as before) would re-execute the shared webpack runtime.js — and
// therefore rebind Bootstrap's modal/dropdown/etc. data-api handlers a second time — every time
// this partial's markup is re-inserted into the DOM, which caused other Bootstrap modals on the
// page to open and immediately close.
$this->getHelper('webpackAssets')->queueStylesheet('tom-select');
$this->getHelper('webpackAssets')->queueScript('tom-select');
$this->jQuery()->addJavascriptFile('/js/administratepaper/paper-assignment-modal.js');

$vid = $this->article->getVid();
$docId = $this->article->getDocid();

$disabled = '';
$ariaDisabled = 'aria-disabled="false"';

$isAllowed = (
    (Episciences_Auth::isSecretary() || $this->article->getEditor(Episciences_Auth::getUid())) &&
    (Episciences_Auth::getUid() != $this->article->getUid() || APPLICATION_ENV === 'development')
);

if (!$isAllowed) {
    $disabled = 'disabled';
    $ariaDisabled = 'aria-disabled="true"';
}

?>

<?= $this->partial('partials/paper_volumes.phtml', [
        'article' => $this->article,
        'volumes' => $this->volumes,
        'isPartial' => false,
        'disabled' => $disabled,
        'ariaDisabled' => $ariaDisabled
    ]
); ?>
    <hr/>
<?= $this->partial('partials/paper_section.phtml', [
    'article' => $this->article,
    'sections' => $this->sections,
    'isPartial' => false,
    'isAllowed' => $isAllowed,
]); ?>
