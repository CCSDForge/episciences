{
  "name": "ccsd/episciences",
  "description": "A platform for overlay journals",
  "require": {
    "php": "~8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-imagick": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-posix": "*",
    "ext-simplexml": "*",
    "ext-xml": "*",
    "ext-xsl": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "apereo/phpcas": "1.6.2",
    "cottagelabs/coarnotify": "dev-main",
    "defuse/php-encryption": "^2.3",
    "doctrine/dbal": "^4.2.5",
    "ezyang/htmlpurifier": "^4.14",
    "geoip2/geoip2": "~3.0",
    "geertw/ip-anonymizer": "^1.1",
    "altcha-org/altcha": "^2.0",
    "guzzlehttp/guzzle": "^7.3",
    "html2text/html2text": "^4.3",
    "laminas/laminas-feed": "^2.18",
    "laravolt/avatar": "^6.0",
    "league/commonmark": "^2.4",
    "league/html-to-markdown": "^5.1",
    "monolog/monolog": "^3.0",
    "phpmailer/phpmailer": "^6.9",
    "ramsey/uuid": "^4.7",
    "seboettg/citeproc-php": "^2.6",
    "shardj/zf1-extras-future": "^1.12",
    "shardj/zf1-future": "1.27.0",
    "smalot/pdfparser": "^2.2",
    "solarium/solarium": "^6.3.1",
    "symfony/cache": "^7.4",
    "symfony/console": "^7.4",
    "symfony/doctrine-messenger": "^7.4",
    "symfony/event-dispatcher": "^7.4",
    "symfony/filesystem": "^7.4",
    "symfony/messenger": "^7.4",
    "symfony/polyfill-mbstring": "*",
    "symfony/polyfill-php84": "*",
    "symfony/property-access": "^7.4",
    "symfony/serializer": "^7.4",
    "symfony/yaml": "^7.4",
    "symfony/intl": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/mime": "^7.4"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "phpmd/phpmd": "@stable",
    "squizlabs/php_codesniffer": "@stable",
    "phpmetrics/phpmetrics": "^2.7",
    "rector/rector": "^2.3",
    "phpstan/phpstan": "^2.1",
    "symfony/test-pack": "^1.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": {
      "unit\\": "tests/unit/"
    },
    "exclude-from-classmap": [
      "tests/unit/library/Episciences/*.php",
      "tests/unit/library/Episciences/paper/*",
      "tests/unit/library/Episciences/Auth/*",
      "tests/unit/library/Episciences/MailingList/*",
      "tests/unit/library/Episciences/Volume/*",
      "tests/unit/library/Episciences/Repositories/*",
      "tests/unit/library/Episciences/Paper/Episciences_Paper_ConflictsManagerDeleteTest.php",
      "tests/unit/library/Episciences/Paper/Episciences_Paper_LicenseCheckStatusTest.php",
      "tests/unit/library/Episciences/Review/*",
      "tests/unit/library/Episciences/Translation/data/*",
      "tests/unit/library/Ccsd/Ccsd_NewsTest.php",
      "tests/unit/library/Ccsd/View/Helper/*",
      "tests/unit/modules/support/NewVersionSpyHooks.php",
      "tests/unit/scripts/ImportApacheLogsCommandTest.php"
    ]
  },
  "license": "GNU GENERAL PUBLIC LICENSE Version 3",
  "support": {
    "docs": "https://docs.episciences.org",
    "source": "https://github.com/CCSDForge/Episciences.git"
  }
}
